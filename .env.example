# MCP/Internals (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose
OUTPUT_FORMAT=webp # png, jpeg, jxl (JPEG XL), webp

# Auth

API_KEY=change-me

# Providers (optional, but you probably want to provide at least one)

SD_URL=http://127.0.0.1:7860
NOVELAI_API_KEY=

# Files

PUBLIC_HOST=
FILES_DIR=files # "files" resolves to /data/files

# Input URL map

# Comma-separated public=private pairs, where the private side is either an absolute http(s) base URL, or a directory.
#
# A directory entry's public key is the only access control for that directory, so make it long and unguessable; the
# private side is never logged.
#
# LibreChat's uploaded images, with its images directory mounted (for example
# /mnt/user/appdata/librechat/client/public/images at /data/librechat-data):
# IMAGE_URL_MAP=https://chat.example.com/images/=/data/librechat-data
#
# A public host an image is served from, reached under a private name:
# IMAGE_URL_MAP=https://example.com=http://example:5080

IMAGE_URL_MAP=
