# MCP/Internals (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose
OUTPUT_FORMAT=webp # png, jpeg, jxl (JPEG XL), webp

# Auth

API_KEY=change-me

# SD WebUI Forge Neo

SD_URL=http://127.0.0.1:7860

# NovelAI (optional)

NOVELAI_API_KEY=

# Public files (required)

# Absolute base URL of this service as clients reach it. Every returned image URL is built from it, so it must be
# reachable from wherever the agent runs. A path component is not allowed; reverse proxies must rewrite instead.

PUBLIC_HOST=

# Files

# 0 retention days means no deletion.

FILES_DIR=files # "files" resolves to /data/files
FILES_RETENTION_DAYS=0

# Database (optional)

# If provided, created automatically.

DB_PATH=neo-mcp.db

# Saved examples (optional)

EXAMPLES_ENABLED=false
EXAMPLES_MAX=16
