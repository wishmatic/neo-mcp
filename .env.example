# MCP/Internals (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal
ERROR_DETAIL=useful # useful, verbose
OUTPUT_FORMAT=webp # png, jpeg, jxl (JPEG XL), webp

# Auth

API_KEY=change-me

# SD WebUI Forge Neo

SD_URL=http://127.0.0.1:7860

# NovelAI (optional)

NOVELAI_API_KEY=

# S3 (optional)

S3_ENDPOINT=

# This is somewhat niche. The S3_ENDPOINT var is used to write to the S3 endpoint. However, in the case you're using
# an S3-compatible backend that can access it directly through, for instance, a private Docker network, and the URL
# you wish the agent to have has a different form, you can specify S3_PUBLIC_ENDPOINT, which is what the URL is
# presigned against.

S3_PUBLIC_ENDPOINT= # Falls back to S3_ENDPOINT when unset.

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_READONLY_ACCESS_KEY=
S3_READONLY_SECRET_KEY=
S3_USE_PATH_STYLE=true

# Garagefront (optional)

# When GARAGEFRONT_URL is set, you do not need S3_READONLY_*. If you don't know what this is, leave it alone.

GARAGEFRONT_URL=

# LibreChat signs its image cookie for i/images/<user id>/*, so set this to the LibreChat user ID; images are then
# uploaded into the directory that cookie covers. Only one user is supported for now.

GARAGEFRONT_USER_ID=

# Shortening (optional)

SHORTENER_API_URL=
SHORTENER_API_KEY=
SHORTENER_EXPIRY_SECONDS=0 # 0 = no expiry.

# img2txt (optional)

# Any OpenAI-compatible vision endpoint. /chat/completions is appended. The system prompt is optional.

IMG2TXT_BASE_URL=
IMG2TXT_API_KEY=
IMG2TXT_MODEL=
IMG2TXT_SYSTEM_PROMPT=

# Database (optional)

# If provided, created automatically.

DB_PATH=neo-mcp.db

# Saved examples (optional)

# Requires S3_*.

EXAMPLES_ENABLED=false
EXAMPLES_MAX=16
